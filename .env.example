# ============================================================
# fitness-ai 环境变量模板
# 用法：复制本文件为 .env，然后把等号右边的值填上
#   Windows PowerShell:  Copy-Item .env.example .env
# ！！！
# 1. 本文件只放“变量名”，绝对不要放真实密码 / API Key
# 2. .env 已被 .gitignore 忽略，填好的 .env 永远不会被提交
# 3. API Key 只能放在 .env 里，绝不能写进代码或提交到 GitHub
# ============================================================

# ---------- MySQL（本地 Docker 容器）----------
MYSQL_HOST=127.0.0.1
# 3307 而不是 3306：本机 Windows 服务 MySQL80 占用了 3306
# （里面有你自己的 thesis_demo / yolo_detection 库），
# Docker 的 MySQL 用 3307，两个实例并存互不干扰。
MYSQL_PORT=3307
MYSQL_DATABASE=fitness
MYSQL_USER=fitness
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- Redis（本地 Docker 容器）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 应用 ----------
APP_NAME=fitness-ai
APP_ENV=dev
APP_DEBUG=true
SECRET_KEY=

# ---------- 大模型 API（第 6 周启用）----------
# DeepSeek 开放平台：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼（通义千问，OpenAI 兼容模式）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
